      "z": 3,
      "locked": false,
      "hidden": false,
      "x": 0,
      "y": 0,
      "w": 60,
      "content": "GODS WEREN'T TRUTH. <span class='red'>GODS WERE TOOLS.</span>",
      "style": {
        "family": "mono",
        "size": 0.78,
        "weight": 500,
        "leading": 1.5,
        "align": "left",
        "italic": false,
        "transform": "uppercase"
      },
      "rotation": 0,
      "wrapNeighbours": false,
      "__order": 2,
      "sectionId": "sec-di0e88"
    },
    {
      "id": "txt-tail",
      "type": "text",
      "z": 4,
      "locked": false,
      "hidden": false,
      "w": 55.5,
      "content": "That is the studio's mild version of the book's loud line. The book could shout it because the book is a paper artefact and you can put the page down. A website cannot shout, because a website is a room you are already standing in. So the studio sets the same sentence in mono caps, indents it, and trusts you to hear the emphasis without the volume.",
      "style": {
        "family": "mono",
        "size": 1.18,
        "weight": 380,
        "leading": 1.62,
        "align": "left",
        "italic": false,
        "transform": "none"
      },
      "wrapNeighbours": true,
      "__order": 3,
      "mode": "flow",
      "sectionId": "sec-di0e88",
      "x": 27.45595079787234,
      "y": 74.8882376486164,
      "positioned": true
    },
