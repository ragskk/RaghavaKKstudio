  "elements": [
    {
      "id": "txt-lead",
      "type": "text",
      "z": 1,
      "locked": false,
      "hidden": false,
      "x": 11.350634419326244,
      "y": 37.00360946478803,
      "w": 50,
      "content": "You needed rain, so you built a god. You needed courage, so you built another. You needed a god to tell you that you were right and the neighbour was wrong, and the neighbour built one too, and the gods argued in the temple while the people, exhausted, slept. None of this was about truth. It was a <span class=\"red\">tooling</span> problem. Thirty-three million instruments for the work of being human.\n\n",
      "style": {
        "family": "serif",
        "size": 1.18,
        "weight": 380,
        "leading": 1.62,
        "align": "right",
        "italic": false,
        "transform": "none",
        "dropCap": true
      },
      "rotation": 0,
      "wrapNeighbours": true,
      "__order": 0,
      "pageAnchor": "center",
      "sectionId": "sec-di0e88",
      "positioned": true
    },
