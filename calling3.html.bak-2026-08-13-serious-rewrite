<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Calling All Gods, Raghava KK</title>
  <meta name="description" content="Calling All Gods. Two paintings, 12.5 × 25 ft each. The gods we use, not the gods we believe in. Parsons School of Design, New York, December 2026 – March 2027." />
  <meta property="og:title" content="Calling All Gods, Raghava KK" />
  <meta property="og:description" content="The gods we use, not the gods we believe in. Two monumental paintings. Parsons School of Design, New York, December 2026 – March 2027." />
  <meta property="og:image" content="https://raghavakkstudio.com/images/Raghava%20KK%20Logo-02.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Raghava KK" />
  <meta name="theme-color" content="#0A0A0A" />
  <link rel="icon" type="image/png" href="./images/Raghava%20KK%20Logo-02.png" />
  <meta name="robots" content="index, follow, noai, noimageai" />
  <meta name="googlebot" content="index, follow, noai, noimageai" />
  <link rel="stylesheet" href="./protect.css" />
  <link rel="stylesheet" href="./css/book-modal.css" />
  <link rel="stylesheet" href="./css/library-shelf.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

    :root {
      --bg:#E8E8E5; --bg-2:#DEDEDA;
      --ink:#0A0A0A; --ink-2:#26251F; --mute:#86857E;
      --paper:#F2F2EF;
      --dark:#0B0B0B; --dark-2:#151512; --on-dark:#EDEDE8; --on-dark-mute:#8E8D85;
      --accent:#FF2E12; --accent-2:#1B33FF;
      --display:'Helvetica Neue', 'Arial', system-ui, sans-serif;
      --body:'Helvetica Neue', 'Arial', system-ui, sans-serif;
      --mono:ui-monospace, Menlo, 'SF Mono', 'Courier New', monospace;
      --ease:cubic-bezier(.16,1,.3,1);
      --ease-2:cubic-bezier(.32,.72,0,1);
      --edge:clamp(1.1rem, 5vw, 5rem);
    }
    html { font-size: 16px; scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    @media (min-width:1280px){ html{ font-size:17px; } }
    body {
      background: var(--bg); color: var(--ink);
      font-family: var(--body); line-height: 1.5;
      -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden; min-height: 100vh;
    }
    body::after {
      content:""; position: fixed; inset:0; z-index: 60; pointer-events:none;
      opacity:.035; mix-blend-mode: multiply;
      background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    }
    img { max-width:100%; display:block; }
    ::selection { background: var(--accent); color:#fff; }
    a { color: inherit; }

    /* floating nav pill */
    .nav {
      position: fixed; top: clamp(.8rem,2vw,1.4rem); left:50%; transform: translateX(-50%);
      z-index: 70; display:flex; align-items:center; gap:.9rem;
      padding:.5rem .55rem .5rem 1.1rem; border-radius:999px;
      background: rgba(12,12,12,.72); color: var(--on-dark);
      backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2);
      border:1px solid rgba(255,255,255,.12);
      box-shadow: 0 10px 40px rgba(0,0,0,.28);
      font-family: var(--mono); font-size: 11px; letter-spacing:.14em; text-transform: uppercase;
      transition: transform .5s var(--ease), opacity .5s var(--ease);
      max-width: calc(100vw - 2rem);
    }
    .nav .dot{ width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px var(--accent);animation:pulse 1.8s ease-in-out infinite;}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
    .nav .nav-t{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .nav .nav-when{ color: var(--on-dark-mute); }
    .nav a.nav-cta{
      text-decoration:none; display:inline-flex; align-items:center; gap:.5rem;
      background: var(--accent); color:#fff; padding:.45rem .5rem .45rem .85rem; border-radius:999px;
      transition: transform .4s var(--ease-2);
    }
    .nav a.nav-cta .arr{ width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.18);display:grid;place-items:center;transition:transform .4s var(--ease-2);}
    .nav a.nav-cta:hover{ transform: scale(.97); } .nav a.nav-cta:hover .arr{ transform: translate(2px,-2px); }
    .nav.hide{ transform: translateX(-50%) translateY(-150%); opacity:0; }
    @media (max-width:560px){ .nav .nav-when{ display:none; } }

    /* full-screen control, top right */
    .fsbtn{ position:fixed; top: clamp(.8rem,2vw,1.4rem); right: clamp(.8rem,2vw,1.4rem); z-index:71;
      display:inline-flex; align-items:center; gap:.5rem; cursor:pointer;
      font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase;
      color:var(--on-dark); background: rgba(12,12,12,.72); border:1px solid rgba(255,255,255,.12);
      backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2);
      padding:.5rem .55rem .5rem .95rem; border-radius:999px; box-shadow: 0 10px 40px rgba(0,0,0,.28);
      transition: transform .4s var(--ease-2), background .4s var(--ease-2), opacity .5s var(--ease); }
    .fsbtn .arr{ width:22px;height:22px;border-radius:50%; background:var(--accent); color:#fff; display:grid; place-items:center; font-size:12px; transition: transform .4s var(--ease-2); }
    .fsbtn:hover{ transform: scale(.97); } .fsbtn:hover .arr{ transform: scale(1.08); }
    @media (max-width:560px){ .fsbtn .fslbl{ display:none; } .fsbtn{ padding:.5rem; } }

    /* reveal */
    .rv{ opacity:0; transform: translateY(40px); filter: blur(8px); transition: opacity .9s var(--ease), transform .9s var(--ease), filter .9s var(--ease); }
    .rv.in{ opacity:1; transform:none; filter:none; }
    .rv.d1{ transition-delay:.08s } .rv.d2{ transition-delay:.16s } .rv.d3{ transition-delay:.24s }
    @media (prefers-reduced-motion: reduce){ .rv{opacity:1;transform:none;filter:none;transition:none} *{animation:none!important} }

    /* shared bits */
    .eyebrow{ display:inline-flex; align-items:center; gap:.6rem; font-family:var(--mono); font-size:11px; letter-spacing:.24em; text-transform:uppercase; color:var(--ink-2); }
    .eyebrow::before{ content:""; width:26px; height:1px; background: var(--accent); }
    .eyebrow.on-dark{ color: var(--on-dark-mute); }
    .kicker{ font-family:var(--mono); font-size:11px; letter-spacing:.24em; text-transform:uppercase; color:var(--mute); }
    h1,h2,h3{ font-family:var(--display); font-weight:800; line-height:.96; letter-spacing:-.005em; }
    .accent{ color: var(--accent); }
    .section{ padding: clamp(4.5rem, 12vw, 11rem) var(--edge); position:relative; }
    .wrap{ max-width: 1500px; margin:0 auto; }

    /* HERO */
    .hero{ position:relative; min-height: 100dvh; display:flex; flex-direction:column; justify-content:flex-end;
      background: var(--dark); color: var(--on-dark); overflow:hidden; padding: 0 var(--edge) clamp(2rem,5vw,4rem); }
    .hero-img{ position:absolute; inset:0; z-index:0; }
    .hero-img img{ width:100%; height:100%; object-fit:cover; opacity:.62; filter: contrast(1.04) saturate(1.05); }
    .hero-img::after{ content:""; position:absolute; inset:0; background:
       linear-gradient(180deg, rgba(11,11,11,.55) 0%, rgba(11,11,11,.18) 32%, rgba(11,11,11,.35) 60%, rgba(11,11,11,.92) 100%); }
    .hero-top{ position:absolute; top: clamp(5.5rem,10vw,7rem); left: var(--edge); right: var(--edge); z-index:2;
      display:flex; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .hero-inner{ position:relative; z-index:2; }
    .hero h1{ font-size: clamp(2.3rem, 10vw, 7.5rem); line-height:.92; text-transform:uppercase; letter-spacing:-.01em; }
    .hero h1 .line{ display:block; white-space:nowrap; }
    .hero h1 em{ font-style: normal; color: var(--accent); }
    .hero-sub{ margin-top: clamp(1.2rem,2vw,2rem); max-width: 56ch; font-size: clamp(1.02rem,1.5vw,1.35rem); line-height:1.5; color: var(--on-dark); }
    .hero-meta{ margin-top: clamp(1.4rem,2.5vw,2.4rem); display:flex; gap: clamp(1.2rem,3vw,3rem); flex-wrap:wrap;
      font-family:var(--mono); font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:var(--on-dark-mute); }
    .hero-meta b{ display:block; color:var(--on-dark); font-weight:500; margin-top:.3rem; font-size:13px; letter-spacing:.06em; }
    .scrollcue{ position:absolute; bottom: clamp(1.2rem,3vw,2rem); right: var(--edge); z-index:2; font-family:var(--mono); font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:var(--on-dark-mute); display:flex; align-items:center; gap:.6rem; }
    .scrollcue .bar{ width:1px; height:42px; background: linear-gradient(var(--accent), transparent); }

    /* THESIS */
    .thesis{ background: var(--bg); }
    .thesis .lede{ font-size: clamp(1.15rem,1.7vw,1.5rem); line-height:1.5; max-width: 40ch; color: var(--ink-2); }
    .megaquote{ font-family:var(--display); font-weight:800; letter-spacing:-.01em; line-height:1;
      font-size: clamp(2.4rem, 8vw, 7rem); text-transform:uppercase; margin-top: clamp(2rem,5vw,4rem); }
    .megaquote .a{ margin-right:.25em; }
    .megaquote .a{ color: var(--ink); } .megaquote .b{ color: var(--accent); display:block; }

    /* Picasso band */
    .band{ background: var(--accent); color:#fff; }
    .band .big{ font-family:var(--display); font-weight:700; font-size: clamp(1.8rem,4.4vw,4.2rem); line-height:1.04; letter-spacing:-.02em; max-width: 24ch; }
    .band .eyebrow{ color:#fff; }
    .band .eyebrow::before{ background:#fff; }

    /* pull-quote moment */
    .quote{ background: var(--bg-2); }
    .quote .pull{ font-family:var(--display); font-weight:800; letter-spacing:-.01em; line-height:1.04;
      font-size: clamp(1.8rem, 5.4vw, 4.6rem); max-width: 22ch; color: var(--ink);
      padding-left: clamp(1rem,3vw,2.4rem); border-left: 6px solid var(--accent); }
    .quote .pull em{ font-style:normal; color: var(--accent); }
    .quote .attr{ margin-top: clamp(.9rem,2vw,1.5rem); padding-left: clamp(1rem,3vw,2.4rem);
      font-family:var(--mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color: var(--mute); }

    /* PLATES bento */
    .plates{ background: var(--bg-2); }
    .plates .head{ display:flex; justify-content:space-between; align-items:flex-end; gap:1.5rem; flex-wrap:wrap; margin-bottom: clamp(2rem,4vw,3.5rem); }
    .plates h2{ font-size: clamp(2.4rem,6vw,5rem); text-transform:uppercase; }
    .bento{ display:grid; grid-template-columns: repeat(12,1fr); gap: clamp(1rem,2vw,1.8rem); }
    .pcard{ position:relative; background: var(--dark); color:var(--on-dark); overflow:hidden; border-radius: 4px; display:flex; flex-direction:column; }
    .pcard.left{ grid-column: 1 / span 6; } .pcard.right{ grid-column: 7 / span 6; }
    .pcard .pic{ position:relative; overflow:hidden; }
    .pcard .pic img{ width:100%; height:100%; object-fit:cover; aspect-ratio: 2 / 1; transition: transform 1.2s var(--ease); }
    .pcard:hover .pic img{ transform: scale(1.04); }
    .pcard .plate-no{ position:absolute; top:.8rem; left:1rem; z-index:2; font-family:var(--display); font-weight:800; font-size: clamp(2.5rem,6vw,5rem); color:#fff; mix-blend-mode: difference; line-height:.8; }
    .pcard .body{ padding: clamp(1.3rem,2.4vw,2.2rem); display:flex; flex-direction:column; gap:.8rem; flex:1; }
    .pcard .t{ font-family:var(--display); font-weight:700; font-size: clamp(1.4rem,2.4vw,2.2rem); letter-spacing:-.01em; line-height:1; }
    .pcard .t em{ font-style:normal; color:var(--accent); }
    .pcard .d{ color: var(--on-dark-mute); font-size:1rem; line-height:1.5; max-width: 44ch; }
    .pcard .meta{ margin-top:auto; font-family:var(--mono); font-size:10.5px; letter-spacing:.16em; text-transform:uppercase; color: var(--on-dark-mute); }
    .spine{ grid-column: 1 / -1; position:relative; background:var(--dark); overflow:hidden; border-radius:4px; }
    .spine img{ width:100%; height:100%; object-fit:cover; max-height: 70vh; opacity:.9; }
    .spine .overlay{ position:absolute; inset:0; display:flex; flex-direction:column; justify-content:space-between; padding: clamp(1.2rem,3vw,2.6rem); pointer-events:none;
      background: linear-gradient(90deg, rgba(11,11,11,.65), rgba(11,11,11,0) 45%); }
    .spine .ov-top{ display:flex; justify-content:space-between; flex-wrap:wrap; gap:1rem; font-family:var(--mono); font-size:11px; letter-spacing:.18em; text-transform:uppercase; color: var(--on-dark); }
    .spine .ov-big{ font-family:var(--display); font-weight:800; color:#fff; font-size: clamp(2rem,6vw,5rem); line-height:.9; text-transform:uppercase; max-width:16ch; }
    .spine .ov-big b{ color: var(--accent); font-weight:800; }
    @media (max-width:820px){ .pcard.left,.pcard.right{ grid-column:1 / -1; } }

    /* THE ASK */
    .ask{ background: var(--dark); color: var(--on-dark); text-align:center; }
    .ask .big{ font-family:var(--display); font-weight:800; text-transform:uppercase; letter-spacing:-.01em; line-height:.96; font-size: clamp(2.6rem,9vw,8.5rem); }
    .ask .big .b{ display:block; color: var(--accent); }
    .ask .tail{ margin-top: clamp(1.4rem,3vw,2.4rem); font-size: clamp(1.05rem,1.6vw,1.4rem); color: var(--on-dark-mute); max-width: 40ch; margin-left:auto; margin-right:auto; }
    .ask .standout{ margin: clamp(1rem,2vw,1.6rem) auto 0; max-width: 26ch;
      font-family:var(--display); font-weight:800; letter-spacing:-.01em; line-height:1.05;
      font-size: clamp(1.4rem,3vw,2.6rem); color:#fff;
      border-top:1px solid rgba(255,255,255,.16); border-bottom:1px solid rgba(255,255,255,.16); padding: clamp(.9rem,2vw,1.4rem) 0; }
    .ask .standout::after{ content:""; }
    .ask .standout em, .ask .standout b{ color: var(--accent); }

    /* STATEMENT collapsible */
    .statement-sec{ background: var(--dark-2); color: var(--on-dark); }
    details.statement{ border-top:1px solid rgba(255,255,255,.14); border-bottom:1px solid rgba(255,255,255,.14); }
    details.statement > summary{ cursor:pointer; list-style:none; padding: clamp(1.4rem,3vw,2.4rem) 0; display:flex; align-items:center; gap:1.2rem; }
    details.statement > summary::-webkit-details-marker{ display:none; }
    details.statement > summary .lbl{ font-family:var(--display); font-weight:800; text-transform:uppercase; letter-spacing:-.02em; font-size: clamp(2rem,6vw,5rem); line-height:.9; }
    details.statement > summary .lbl em{ font-style:normal; color: var(--accent); }
    details.statement > summary .open-pill{ margin-left:auto; flex:0 0 auto; display:inline-flex; align-items:center; gap:.55rem; font-family:var(--mono); font-size:11px; letter-spacing:.18em; text-transform:uppercase; color: var(--on-dark);
      border:1px solid rgba(255,255,255,.25); border-radius:999px; padding:.6rem .7rem .6rem 1rem; transition: background .4s var(--ease-2), color .4s var(--ease-2); }
    details.statement > summary .open-pill .arr{ width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center; transition: transform .5s var(--ease-2); }
    details.statement[open] > summary .open-pill .arr{ transform: rotate(90deg); }
    details.statement > summary:hover .open-pill{ background: var(--accent); border-color:var(--accent); }
    .stmt-body{ display:grid; grid-template-columns: 1fr; gap: clamp(2rem,4vw,3rem); padding: clamp(1.5rem,3vw,2.5rem) 0 clamp(2rem,4vw,3.5rem); }
    @media (min-width:980px){ .stmt-body{ grid-template-columns: 1fr 1fr; align-items:start; } }
    .stmt-prose p{ font-size: clamp(1.05rem,1.35vw,1.18rem); line-height:1.65; color: var(--on-dark); max-width: 56ch; }
    .stmt-prose p + p{ margin-top: 1rem; }
    .stmt-prose .open{ font-family:var(--display); font-weight:700; font-size: clamp(1.5rem,2.4vw,2.1rem); line-height:1.12; letter-spacing:-.01em; color:#fff; margin-bottom:1.2rem; max-width: 22ch; }
    .stmt-prose em{ color: var(--accent); font-style:italic; }
    .stmt-prose .sign{ display:block; margin-top:1.6rem; font-family:var(--mono); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color: var(--on-dark-mute); }
    .fn-marker{ cursor:pointer; color: var(--accent); font-family:var(--mono); font-size:.7em; vertical-align:super; font-weight:600; }
    .fnotes .fnh{ font-family:var(--mono); font-size:10px; letter-spacing:.22em; text-transform:uppercase; color: var(--on-dark-mute); margin-bottom:.6rem; }
    details.fnote{ border-top:1px solid rgba(255,255,255,.14); }
    details.fnote:last-child{ border-bottom:1px solid rgba(255,255,255,.14); }
    details.fnote > summary{ cursor:pointer; list-style:none; padding:1rem 0; display:flex; align-items:baseline; gap:.7rem; font-family:var(--display); font-weight:600; font-size: clamp(1.05rem,1.5vw,1.3rem); line-height:1.2; color: var(--on-dark); }
    details.fnote > summary::-webkit-details-marker{ display:none; }
    details.fnote > summary .star{ font-family:var(--mono); color:var(--accent); flex:0 0 auto; }
    details.fnote > summary .ch{ margin-left:auto; font-family:var(--mono); font-size:10px; letter-spacing:.16em; text-transform:uppercase; color: var(--on-dark-mute); }
    details.fnote[open] > summary .ch{ color: var(--accent); }
    details.fnote .fb{ padding:0 0 1.2rem 1.6rem; }
    details.fnote .fb p{ font-size:.98rem; line-height:1.6; color: var(--on-dark-mute); max-width:56ch; }
    details.fnote .fb p + p{ margin-top:.8rem; }
    details.fnote .fb em{ color: var(--accent); font-style:italic; }
    .fnotes .fn-book{ display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;
      margin-top:.2rem; padding:1.1rem 0; border-top:1px solid rgba(255,255,255,.14); border-bottom:1px solid rgba(255,255,255,.14);
      text-decoration:none; color:var(--on-dark); transition: padding .35s var(--ease-2); }
    .fnotes .fn-book .fb-l{ font-family:var(--display); font-weight:600; font-size: clamp(1.05rem,1.5vw,1.3rem); line-height:1.15; }
    .fnotes .fn-book .fb-cta{ font-family:var(--mono); font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:var(--accent); display:inline-flex; align-items:center; gap:.55rem; white-space:nowrap; }
    .fnotes .fn-book .fb-cta .ar{ width:22px;height:22px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center; transition:transform .4s var(--ease-2); }
    .fnotes .fn-book:hover .fb-cta .ar{ transform: translate(2px,-2px); }

    /* IN THE ROOM */
    .room{ background: var(--bg); }
    .room .head{ margin-bottom: clamp(2rem,4vw,3.5rem); }
    .room h2{ font-size: clamp(2.4rem,6vw,5rem); text-transform:uppercase; }
    .panel{ background: var(--paper); border-radius:6px; padding: clamp(1.4rem,3vw,2.6rem); box-shadow: 0 30px 60px -40px rgba(0,0,0,.4); }
    .panel + .panel{ margin-top: clamp(1.2rem,2.5vw,2rem); }
    .panel .ph{ display:flex; justify-content:space-between; align-items:baseline; gap:1rem; flex-wrap:wrap; margin-bottom:1.2rem; }
    .panel .ph .t{ font-family:var(--display); font-weight:700; font-size: clamp(1.5rem,2.6vw,2.2rem); text-transform:uppercase; letter-spacing:-.01em; }
    .panel .ph .n{ font-family:var(--mono); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--mute); }
    .panel .lead{ color: var(--ink-2); max-width: 60ch; margin-bottom:1.4rem; font-size:1.05rem; }
    .pantheon{ display:grid; grid-template-columns: repeat(4,1fr); gap: clamp(.6rem,1.4vw,1.1rem); }
    .god{ position:relative; aspect-ratio: 3/4; background: var(--bg-2); border-radius:4px; overflow:hidden; display:flex; align-items:flex-end; }
    .god model-viewer{ position:absolute; inset:0; width:100%; height:100%; background:transparent; --poster-color:transparent; transform: scale(.75); transform-origin: center; }
    .god .gname{ position:relative; z-index:2; width:100%; padding:.6rem .7rem; font-family:var(--display); font-weight:700; font-size: clamp(.85rem,1.1vw,1.05rem); text-transform:uppercase; letter-spacing:-.01em; background: linear-gradient(transparent, rgba(0,0,0,.05)); }
    .god .gph{ position:absolute; inset:0; display:grid; place-items:center; z-index:0; font-family:var(--display); font-weight:800; font-size: 2.4rem; color: rgba(10,10,10,.10); text-transform:uppercase; }
    @media (max-width:700px){ .pantheon{ grid-template-columns: repeat(2,1fr);} }
    .panel .marg{ margin-top:.8rem; font-family:var(--mono); font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--mute); }
    .panel .marg .accent{ color:var(--accent); }
    #callingZineShelf{ min-height: 200px; }

    /* FOOTER */
    .foot{ background: var(--dark); color: var(--on-dark); }
    .foot .grid{ display:grid; grid-template-columns:1fr; gap: clamp(2rem,5vw,4rem); }
