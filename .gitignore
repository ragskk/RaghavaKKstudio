# ── Off-site holding zone (root cleanup 2026-08-30) ──────────────────────
# Everything not part of the live website lives here: source material,
# unaccessioned books, archived pages/backups/experiments, notes, scratch.
not-used/

# Separate sub-projects (campaign app + its backups, inventory app) — own repos
/sub-projects/

# Local backups (tags are the rewind mechanism); pre-cleanup snapshot has ROLLBACK.sh
_backups/

# Oversize file: 143 MB, exceeds GitHub's 100 MB single-file limit
# (book-modal serves it as requestOnly + mailto fallback)
books/art books/Restless Frequency.pdf

# C2PA signing keys — private, never ship
/_tools/c2pa/*.key
/_tools/c2pa/*.csr
/_tools/c2pa/*.srl
/_tools/c2pa/*.pk8
/_tools/__pycache__/

# OS / tooling cruft
.DS_Store
.vercel/
